# Chave da API Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Para onde as mensagens do formulario sao enviadas
CONTACT_TO_EMAIL=seu-email@exemplo.com

# Remetente. Sem dominio verificado use exatamente: Portfolio <onboarding@resend.dev>
# (nesse modo a Resend so entrega para o e-mail dono da conta, o que ja atende o formulario)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# URL do site (canonical, sitemap, robots e Open Graph).
#
# SEM o prefixo NEXT_PUBLIC_ de proposito: e lida so no servidor e nunca vai
# para o navegador. Na Vercel, marque como "Config" (nao "Secret") — nao e
# segredo, e o painel so deixa marcar Secret o que nao e publico.
#
# Local:    http://localhost:3000
# Na Vercel: a URL REAL do site, ex.: https://victormotta.dev
#
# Deixar localhost em producao nao quebra o build — e pior: o Google indexa
# canonical e sitemap apontando para uma maquina que ele nao alcanca, e o link
# compartilhado no WhatsApp/LinkedIn nao gera preview.
#
# O protocolo entra sozinho se voce esquecer ("victormotta.dev" vira
# "https://victormotta.dev"), e sem a variavel a Vercel usa o dominio do
# proprio projeto.
SITE_URL=http://localhost:3000
