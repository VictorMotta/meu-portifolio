# Chave da API Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Para onde as mensagens do formulário são enviadas
CONTACT_TO_EMAIL=seu-email@exemplo.com

# Remetente. Sem domínio verificado use exatamente: Portfólio <onboarding@resend.dev>
# (nesse modo a Resend só entrega para o e-mail dono da conta, o que já atende o formulário)
CONTACT_FROM_EMAIL=Portfólio <onboarding@resend.dev>

# URL do site (canonical, sitemap, robots e Open Graph).
#
# SEM o prefixo NEXT_PUBLIC_ de propósito: é lida só no servidor e nunca vai
# para o navegador. Na Vercel, marque como "Config" (não "Secret") — não e
# segredo, e o painel só deixa marcar Secret o que não é público.
#
# Local:    http://localhost:3000
# Na Vercel: a URL REAL do site, ex.: https://victormotta.dev
#
# Deixar localhost em produção não quebra o build — é pior: o Google indexa
# canonical e sitemap apontando para uma maquina que ele não alcança, e o link
# compartilhado no WhatsApp/LinkedIn não gera preview.
#
# O protocolo entra sozinho se você esquecer ("victormotta.dev" vira
# "https://victormotta.dev"), e sem a variável a Vercel usa o domínio do
# próprio projeto.
SITE_URL=http://localhost:3000
